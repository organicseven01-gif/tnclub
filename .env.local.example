# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto Supabase
# (Project Settings > API, em app.supabase.com).
#
# NEXT_PUBLIC_* fica exposto ao navegador — use apenas a chave "anon/public",
# nunca a "service_role" aqui.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI
