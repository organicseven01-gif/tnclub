# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto Supabase
# (Project Settings > API, em app.supabase.com).
#
# NEXT_PUBLIC_* fica exposto ao navegador — use apenas a chave "anon/public",
# nunca a "service_role" aqui.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# URL pública da plataforma (usada nos links de boas-vindas por e-mail/WhatsApp).
NEXT_PUBLIC_SITE_URL=https://tnclub.com.br

# E-mail de boas-vindas (Resend — https://resend.com). Opcional: sem a chave,
# o cadastro funciona normalmente, só não envia e-mail.
# RESEND_API_KEY nunca deve ter o prefixo NEXT_PUBLIC (é segredo de servidor).
RESEND_API_KEY=
# EMAIL_REMETENTE="TN Club <contato@tnclub.com.br>"  # após verificar o domínio no Resend
